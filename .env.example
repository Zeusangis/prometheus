FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Non-Docker local default; Docker configuration will use a postgres hostname.
DATABASE_URL=sqlite:///talent_intelligence.db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:5173
# Optional absolute backend storage directory; never returned to clients.
UPLOAD_FOLDER=

# Server-only resume provider; an empty key persists a safe failed analysis state.
GEMINI_API_KEY=
# Override this if a different model is required for the key or region.
GEMINI_MODEL=gemini-flash-lite-latest
# Optional read-only server token for bounded public GitHub evidence collection.
GITHUB_TOKEN=
# Reserved interview integration; live interviews remain disabled.
NAVTALK_API_KEY=
NAVTALK_NAME=
NAVTALK_AVATAR_ID=

# Empty uses relative /api requests with the Vite dev proxy.
# Put frontend overrides in frontend_hackathon_1/.env.local if required.
VITE_API_BASE_URL=
