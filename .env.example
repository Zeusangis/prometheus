FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Non-Docker local default; Docker configuration will use a postgres hostname.
DATABASE_URL=sqlite:///talent_intelligence.db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:5173
# Optional absolute backend storage directory; never returned to clients.
UPLOAD_FOLDER=

# Reserved server-only provider settings; integrations are not yet implemented.
GEMINI_API_KEY=
GITHUB_TOKEN=
NAVTALK_API_KEY=
NAVTALK_NAME=
NAVTALK_AVATAR_ID=

# Empty uses relative /api requests with the Vite dev proxy.
# Put frontend overrides in frontend_hackathon_1/.env.local if required.
VITE_API_BASE_URL=
